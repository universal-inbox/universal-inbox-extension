{
  "private": true,
  "name": "universal-inbox-extension",
  "description": "Universal Inbox browser extension",
  "version": "0.1.0",
  "author": {
    "name": "David Rousselie",
    "email": "david@universal-inbox.com",
    "url": "https://www.universal-inbox.com"
  },
  "license": "Apache",
  "type": "module",
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@types/chrome": "^0.0.270",
    "eslint": "^9.29.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.5.0",
    "extension": "^2.1.3",
    "typescript": "5.3.3"
  },
  "scripts": {
    "dev": "extension dev --polyfill --port 8888 ",
    "dev-firefox": "extension dev --polyfill --browser firefox --port 8888 ",
    "start": "extension start --polyfill --port 8888",
    "build": "extension build --polyfill",
    "build-firefox": "extension build --browser firefox --polyfill",
    "format": "prettier --write 'src/**/*.{js,ts,css,html}'",
    "lint": "eslint 'src/**/*.{js,ts}'",
    "type-check": "tsc --noEmit"
  }
}
